# =============================================================================
# NeuroScan-AI — .gitignore
# =============================================================================


# =============================================================================
# DEPLOYMENT FILES  (main branch only — not needed locally)
# =============================================================================
# Uncomment these lines on the local branch to prevent accidental commits.
# On main branch these files MUST be committed for Render + Vercel to work.
#
# backend/Procfile
# backend/runtime.txt
# backend/render.yaml
# railway.toml
# frontend/vercel.json
# frontend/.env.production


# =============================================================================
# SECRETS & ENVIRONMENT
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
service_account.json
credentials.json
firebase*.json
cloudflare*.json


# =============================================================================
# PYTHON / FASTAPI BACKEND
# =============================================================================

# Byte-compiled / optimised files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/

# Python version file
# .python-version


# =============================================================================
# ML / AI MODEL FILES  (large binaries — store on cloud / LFS instead)
# =============================================================================
*.h5
*.pkl
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors
*.joblib

# ── Force-include NeuroScan model files (both under 100 MB GitHub limit) ──────
!backend/ml_models/Epilepsy.h5
!backend/ml_models/EpilepsyImage.h5

# Allow the placeholder so the folder is tracked
!backend/ml_models/.gitkeep


# =============================================================================
# DATASET / DATA FILES
# =============================================================================
*.csv
*.parquet
*.npy
*.npz
*.edf
*.dat
*.hdf5
*.h5ad
backend/data.csv

# JSON: ignore large data dumps but keep config files
*.data.json
*.dataset.json

# Keep standard config JSONs
!package.json
!package-lock.json
!tsconfig*.json
!vite.config.*
!tailwind.config.*
!postcss.config.*
!eslint*.json
!.eslintrc*
!.prettierrc*
!vercel.json
!render.yaml


# =============================================================================
# UPLOADS (keep placeholder, ignore actual user files)
# =============================================================================
backend/uploads/*
!backend/uploads/.gitkeep
uploads/


# =============================================================================
# NODE / REACT / VITE FRONTEND
# =============================================================================
node_modules/
frontend/node_modules/

# Build output
dist/
dist-ssr/
frontend/dist/
frontend/build/
.next/
out/

# Vite cache
.vite/
frontend/.vite/

# Storybook
storybook-static/

# Lock files (keep npm's, ignore others if not used)
# yarn.lock
# pnpm-lock.yaml

# Turbo monorepo cache
.turbo/

# Local env overrides (Vite)
*.local

# Parcel cache
.parcel-cache/


# =============================================================================
# CLOUDFLARE R2 / AWS / GCP CREDENTIALS
# =============================================================================
.wrangler/
wrangler.toml
*.wasm
rclone.conf


# =============================================================================
# DATABASE FILES
# =============================================================================
*.db
*.sqlite
*.sqlite3


# =============================================================================
# JUPYTER NOTEBOOKS
# =============================================================================
.ipynb_checkpoints/
**/.ipynb_checkpoints/


# =============================================================================
# COMPILED / BINARY ARTIFACTS
# =============================================================================
*.d
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.smod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app


# =============================================================================
# OS GENERATED FILES
# =============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
__MACOSX/

# Windows
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~


# =============================================================================
# IDEs & EDITORS
# =============================================================================
.idea/
.vscode/
*.swp
*.swo
*.suo
*.user
*.workspace
*.code-workspace
.history/
.fleet/
*.iml


# =============================================================================
# CLAUDE AI / AI ASSISTANT FOLDERS (local only)
# =============================================================================
.claude/
.gemini/
.cursor/


# =============================================================================
# LOGS & TEMPORARY FILES
# =============================================================================
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# =============================================================================
# MISC
# =============================================================================
*.tmp
*.temp
*.bak
*.orig
*.swp
/extra
.nyc_output/
.cache/
coverage/
